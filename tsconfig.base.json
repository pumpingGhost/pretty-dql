{
  "compilerOptions": {
    "target": "ES2020",
    // Modern JavaScript features
    "module": "CommonJS",
    // Node.js module system
    "strict": true,
    // Enable strict type checking
    "declaration": true,
    // Generate declaration files
    "esModuleInterop": true
    // Allow default imports from CommonJS modules
  },
  "exclude": [
    "test",
    "node_modules",
    "dist",
    "playground"
  ]
}

